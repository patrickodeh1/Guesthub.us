APP_NAME="Guest Welcome"
# Production defaults. For local development set APP_ENV=local and APP_DEBUG=true in your own .env.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_TIMEZONE=America/New_York
APP_DISPLAY_TIMEZONE=America/New_York
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel prefixes database and user names with your account name.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_guesthub
DB_USERNAME=cpaneluser_guesthub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The queue is the database. A queue worker cron is REQUIRED (see the deploy guide).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: uses standard SMTP (works with cPanel's mail service or, for local
# testing, Gmail SMTP: smtp.gmail.com:587 with an app password, since Gmail
# blocks regular account passwords for SMTP). No third-party mail API
# required; switch MAIL_HOST/PORT/USERNAME/PASSWORD to your real values.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Government-ID scanning (name/DOB/expiry) via Google Cloud Vision OCR.
# First 1,000 DOCUMENT_TEXT_DETECTION calls/month are free; a GCP billing
# account with a card on file is still required to enable the API.
GOOGLE_VISION_API_KEY=
# Writes the raw OCR text (personal data!) to the log so the ID parser can be
# tuned against real IDs. Leave false except while actively debugging.
GOOGLE_VISION_DEBUG_LOG=false

# Google Geocoding API Key for property address geocoding / lat-long lookups.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Telnyx SMS notifications
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_ADMIN_NOTIFY_NUMBER=
SMS_ENABLED=false

# Channex (channel manager). The code defaults to the STAGING address below.
# Keep it on staging until you have a production Channex account.
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=
# Read by the code but not set in your local .env, so the code defaults apply.
# Leave commented unless config shows you need them.
# PMS_PROVIDER=
# PMS_POLL_INTERVAL_MINUTES=

# PriceLabs rates
PRICELABS_API_KEY=

# Seam (smart locks)
SEAM_API_KEY=
SEAM_WEBHOOK_SECRET=

# Stripe payments (use live keys on production)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Video optimisation. Needs ffmpeg on the server; many shared hosts have none.
# Check with `which ffmpeg` before relying on it.
# FFMPEG_BINARIES=/usr/bin/ffmpeg
# FFPROBE_BINARIES=/usr/bin/ffprobe
# FFMPEG_TEMPORARY_FILES_ROOT=
