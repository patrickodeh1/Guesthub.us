##########################
# Dependencies
##########################
/vendor/
/node_modules/
/npm/
/php/
/composer/
cleaning/vendor/
cleaning/npm/
cleaning/php/
cleaning/composer/

##########################
# Environment / secrets
##########################
.env
*.env.backup
*.env.bak
/auth.json

##########################
# Laravel runtime/cache
##########################
/bootstrap/cache/*.php
cleaning/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/logs/.gitkeep
cleaning/storage/framework/cache/data/*
cleaning/storage/framework/sessions/*
cleaning/storage/framework/views/*
cleaning/storage/logs/*
!cleaning/storage/logs/.gitkeep
/.phpunit.result.cache
cleaning/.phpunit.result.cache
error_log
**/error_log

##########################
# User-uploaded content
##########################
/storage/app/public/*
!/storage/app/public/.gitkeep
cleaning/storage/app/public/*
!cleaning/storage/app/public/.gitkeep
/public/storage/
cleaning/public/storage/
cleaning/public/files/

##########################
# Backups, dumps, and exports
##########################
*backup*
*.sql
*.sql.gz
*.zip
!cleaning/public/vendor/ffmpeg/**/*.zip
**/storage_backup*/
**/*broken_backup*/

